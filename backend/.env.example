# 本機開發用（複製成 .env）。Docker 部署的設定在 docker-compose.yml，不會讀這個檔案。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
SECRET_KEY="YourSecretKeyHere"  # Replace with your actual secret key !!important!!
FERNET_KEY="zCb-XFSg6qE4hr63-7siw_bVnUuQi3Q6JQfRqvsNt3Y="  # Replace with your actual Fernet key !!important!!
ALGORITHM=HS256 # JWT algorithm
TOKEN_EXPIRE_MINUTES=300 # Token expiration time in minutes
CHROMADB_PATH=./db/chroma_db # Path to your ChromaDB database
# 菜單資料庫：設定 DB_URL 使用 PostgreSQL；註解掉則使用 DB_PATH 的 SQLite
DB_URL=postgresql://postgres:postgres@localhost:5432/morning_eat
DB_PATH=./db/morning_eat.db # Path to your SQLite database
# LLM：Ollama 模型名稱，或 gemini_api（需設定 GOOGLE_API_KEY）。未設定時程式預設為 gemini_api
LLM_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434
GOOGLE_API_KEY="your_google_ai_studio_api_key"  # Only needed when LLM_MODEL=gemini_api
# ASR Configuration (Local transformers backend, Moonshine)
ASR_MODEL="moonshine-ai/moonshine-streaming-tiny-zh"
HF_HOME="/tmp/huggingface_cache"
